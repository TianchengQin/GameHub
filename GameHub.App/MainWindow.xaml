<ui:FluentWindow x:Class="GameHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:GameHub.App"
        mc:Ignorable="d"
        Title="GameHub" Height="800" Width="1320" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="GameHub" Margin="0,-40,0,0"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Padding="12">
                <StackPanel>
                    <TextBlock Text="GameHub" FontSize="20" FontWeight="SemiBold" Margin="4,0,0,16"/>

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNavItem}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AllowDrop" Value="True"/>
                                <EventSetter Event="DragOver" Handler="OnNavItemDragOver"/>
                                <EventSetter Event="Drop" Handler="OnNavItemDrop"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe Fluent Icons" Width="24"/>
                                    <TextBlock Text="{Binding Label}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Margin="0,12"/>

                    <TextBlock Text="把游戏卡片拖到上方分组即可加入该分组" Opacity="0.5" FontSize="11"
                               TextWrapping="Wrap" Margin="4,0,0,12"/>

                    <ui:Button Content="管理分组" Appearance="Secondary"
                               Command="{Binding ManageGroupsCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <ui:Button Content="收藏悬浮窗" Appearance="Secondary"
                               Command="{Binding ToggleFloatingWindowCommand}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <ui:Button Content="设置" Appearance="Secondary"
                               Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1" Margin="8,0,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:TextBox Grid.Column="0" PlaceholderText="搜索游戏…"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                MaxWidth="320" HorizontalAlignment="Left"/>

                    <ui:Button Grid.Column="1" Content="从开始菜单导入" Appearance="Secondary"
                               Command="{Binding ScanStartMenuCommand}" Margin="0,0,8,0"/>
                    <ui:Button Grid.Column="2" Content="扫描文件夹" Appearance="Secondary"
                               Command="{Binding ScanFolderCommand}" Margin="0,0,8,0"/>
                    <ui:Button Grid.Column="3" Content="添加游戏" Appearance="Primary"
                               Command="{Binding AddGameCommand}"/>
                </Grid>

                <Grid Grid.Row="1">
                    <TextBlock Text="库是空的，点击右上角&quot;添加游戏&quot;/&quot;扫描文件夹&quot;，或直接把 exe 拖进这个窗口。"
                               Visibility="{Binding HasNoGames, Converter={StaticResource BoolToVis}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.6" FontSize="16"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GamesView}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="280" Margin="8" CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            ClipToBounds="True"
                                            PreviewMouseLeftButtonDown="OnGameCardPreviewMouseDown"
                                            PreviewMouseMove="OnGameCardPreviewMouseMove">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="查看详情" Command="{Binding OpenDetailsCommand}"/>
                                                <MenuItem Header="收藏/取消收藏" Command="{Binding ToggleFavoriteCommand}"/>
                                                <MenuItem Header="在文件夹中显示" Command="{Binding OpenContainingFolderCommand}"/>
                                                <Separator/>
                                                <MenuItem Header="从库中移除" Command="{Binding RemoveCommand}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Image Grid.Row="0" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding CoverImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                                   Visibility="{Binding HasCustomCover, Converter={StaticResource BoolToVis}}"/>

                                            <Image Grid.Row="0" Stretch="Uniform" Width="84" Height="84"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding IconImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                                                   Visibility="{Binding IsIconOnly, Converter={StaticResource BoolToVis}}"/>

                                            <TextBlock Grid.Row="0" Text="🎮" FontSize="48" Opacity="0.3"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding CoverImagePath, Converter={StaticResource CoverPlaceholderVisibilityConverter}}"/>

                                            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                    Panel.ZIndex="5"
                                                    Padding="6,2" FontSize="20" Foreground="Gold" Cursor="Hand"
                                                    Background="#66000000" BorderThickness="0"
                                                    ToolTip="收藏 / 取消收藏"
                                                    Command="{Binding ToggleFavoriteCommand}"
                                                    Content="{Binding IsFavorite, Converter={StaticResource FavoriteGlyphConverter}}"/>

                                            <Border Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                                    Background="#CCB00020" Padding="6"
                                                    Visibility="{Binding IsPathMissing, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="路径已失效" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="10,6">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding LastPlayedAt, Converter={StaticResource RelativeTimeConverter}}"
                                                           Opacity="0.6" FontSize="12"/>
                                            </StackPanel>

                                            <Border Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                                    Background="#AA000000" Padding="8">
                                                <ui:Button Content="{Binding LaunchLabel}" Appearance="Primary"
                                                           Command="{Binding LaunchCommand}" HorizontalAlignment="Stretch"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                MaxWidth="380" Padding="16,12" CornerRadius="8"
                Background="#E6202020" BorderBrush="#40FFFFFF" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ToastMessage}" Foreground="White" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</ui:FluentWindow>

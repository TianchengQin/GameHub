<Window x:Class="GameHub.App.Views.FloatingFavoritesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameHub 收藏"
        SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="OnDragMove">

    <Border Background="#E61E1E22" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="14"
            Padding="10" Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="2,0,2,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="✕" FontSize="11" Padding="6,2" Cursor="Hand"
                        Background="Transparent" BorderThickness="0" Foreground="#99FFFFFF"
                        ToolTip="关闭悬浮窗" Click="OnCloseClick"/>
                <TextBlock Text="★ 收藏" Foreground="#CCFFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>

            <ScrollViewer Grid.Row="1" MaxHeight="260" MaxWidth="340"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FavoritesView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel MaxWidth="320"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Width="68" Height="68" Margin="3" Padding="6" Cursor="Hand"
                                    Background="#22FFFFFF" BorderThickness="0"
                                    Command="{Binding LaunchCommand}"
                                    ToolTip="{Binding Name}">
                                <Grid>
                                    <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform"
                                           Source="{Binding CoverImagePath, Converter={StaticResource PathToImageSourceConverter}}"/>
                                    <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding CoverImagePath, Converter={StaticResource CoverPlaceholderVisibilityConverter}}"/>
                                    <Ellipse Width="9" Height="9" Fill="LimeGreen" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="1" Text="还没有收藏的游戏&#x0a;在主界面点击卡片右上角的 ☆" Foreground="#99FFFFFF" FontSize="12"
                       TextAlignment="Center" Margin="12,6" x:Name="EmptyHint" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>

<ui:FluentWindow x:Class="GameHub.App.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="设置"
                 Width="560" Height="680"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="设置" Margin="0,-40,0,0"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="更新" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding CurrentVersionText, StringFormat='当前版本：{0}'}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button Content="检查更新" Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,0"/>
                    <ui:Button Content="下载并安装" Appearance="Primary" Command="{Binding InstallUpdateCommand}" Margin="0,0,8,0"/>
                    <ui:Button Content="查看发布页" Appearance="Secondary" Command="{Binding OpenReleasePageCommand}"/>
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatus}" Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ProgressBar Value="{Binding UpdateProgress}" Maximum="100" Height="6" Margin="0,0,0,8"
                             Visibility="{Binding IsUpdateBusy, Converter={StaticResource BoolToVis}}"/>
                <CheckBox Content="启动时自动检查更新" IsChecked="{Binding AutoCheckUpdates}" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="外观" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <TextBlock Text="主题" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                          HorizontalAlignment="Left" MinWidth="160" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="启动行为" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <CheckBox Content="启动游戏后自动最小化到系统托盘" IsChecked="{Binding MinimizeToTrayOnLaunch}" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="在线封面 (SteamGridDB)" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="在 steamgriddb.com 注册后，到个人偏好设置里生成 API Key 并填在这里，即可在游戏详情页在线搜索高清封面。"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ui:TextBox PlaceholderText="API Key" Text="{Binding SteamGridDbApiKey, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="文件夹扫描黑名单规则" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,4"/>
                <TextBlock Text="扫描文件夹时，文件名匹配以下任一规则（支持 * 通配符）的 exe 不会出现在候选列表中。"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" PlaceholderText="例如 *launcher*.exe"
                                Text="{Binding NewPattern, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                    <ui:Button Grid.Column="1" Content="添加" Command="{Binding AddPatternCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding BlacklistPatterns}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center" FontFamily="Consolas"/>
                                <ui:Button Grid.Column="1" Content="删除" Appearance="Danger"
                                           Command="{Binding DataContext.RemovePatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="数据与缓存" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding AppDataRoot}" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ui:Button Content="打开数据文件夹" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                <Separator Margin="0,0,0,16"/>

                <TextBlock Text="备份" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <TextBlock Text="把整个游戏库（游戏列表、分组、统计数据）导出为一个 JSON 文件，换电脑或重装系统后可以导入恢复。"
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="导出备份…" Command="{Binding ExportLibraryCommand}" Margin="0,0,8,0"/>
                    <ui:Button Content="导入备份…" Appearance="Secondary" Command="{Binding ImportLibraryCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="关闭" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

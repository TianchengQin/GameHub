<ui:FluentWindow x:Class="GameHub.App.Views.GroupManagerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="管理分组"
                 Width="420" Height="520"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="管理分组" Margin="0,-40,0,0"/>

        <Grid Grid.Row="0" Margin="16,8,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0" PlaceholderText="新分组名称"
                        Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"/>
            <ui:Button Grid.Column="1" Content="添加" Appearance="Primary" Margin="8,0,0,0"
                       Command="{Binding AddGroupCommand}"/>
        </Grid>

        <ListBox Grid.Row="1" Margin="16,0,16,8"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid AllowDrop="True" Background="Transparent" Drop="OnRowDrop" DragOver="OnRowDragOver">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="⠿" FontSize="18" Opacity="0.6" Cursor="SizeAll"
                                   VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="拖动调整顺序"
                                   PreviewMouseMove="OnGripMouseMove"/>
                        <ui:TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="重命名" Command="{Binding RenameSelectedGroupCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="删除" Appearance="Danger" Command="{Binding DeleteSelectedGroupCommand}" Margin="0,0,8,0"/>
            <ui:Button Content="关闭" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>

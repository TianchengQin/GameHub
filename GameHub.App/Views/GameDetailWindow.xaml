<ui:FluentWindow x:Class="GameHub.App.Views.GameDetailWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="游戏详情"
                 Width="620" Height="680"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="游戏详情" Margin="0,-40,0,0"/>

        <ScrollViewer Grid.Row="1" Margin="16,0,16,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="120" Height="160" CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                        <Image Source="{Binding PreviewImagePath, Converter={StaticResource PathToImageSourceConverter}}"
                               Stretch="Uniform" Margin="12"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Content="更换封面图" Command="{Binding ChooseCoverImageCommand}" Margin="0,0,8,0"/>
                            <ui:Button Content="在线搜索封面" Appearance="Secondary" Click="OnSearchCoverOnlineClick"/>
                        </StackPanel>
                        <TextBlock Text="统计信息" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <TextBlock Text="{Binding DateAdded, StringFormat='添加时间：{0:yyyy-MM-dd HH:mm}'}" Opacity="0.75"/>
                        <TextBlock Text="{Binding LastPlayedAt, StringFormat='上次启动：{0:yyyy-MM-dd HH:mm}', TargetNullValue='上次启动：从未启动'}" Opacity="0.75"/>
                        <TextBlock Text="{Binding PlayCount, StringFormat='启动次数：{0} 次'}" Opacity="0.75"/>
                        <TextBlock Text="{Binding TotalPlaytimeDisplay, StringFormat='总游玩时长：{0}'}" Opacity="0.75"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="名称" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="可执行文件路径" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding ExecutablePath}" IsReadOnly="True" Margin="0,0,8,0"/>
                    <ui:Button Grid.Column="1" Content="重新定位…" Command="{Binding RelocateExecutableCommand}"/>
                </Grid>

                <TextBlock Text="启动参数（可选）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="工作目录（留空则使用 exe 所在目录）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                            TextWrapping="Wrap" Height="70" Margin="0,0,0,12"/>

                <TextBlock Text="所属分组" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding GroupMemberships}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,0,16,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16">
            <ui:Button Content="取消" Margin="0,0,8,0" Click="OnCancelClick"/>
            <ui:Button Content="保存" Appearance="Primary" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
